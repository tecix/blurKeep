{
  "manifest_version": 2,
  "name": "BlurKeep",
  "version": "2.0.4",
  "description": "Blur background notes when editing in Google Keep for distraction-free focus",
  "author": "tecix",
  "homepage_url": "https://github.com/tecix/blurKeep",
  "browser_specific_settings": {
    "gecko": {
      "id": "blurkeep@tecix",
      "strict_min_version": "150.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://keep.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "BlurKeep",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  }
}
